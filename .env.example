# Telegram Bot Token
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin IDs (comma separated)
ADMIN_ID=12345678,87654321

# Group and thread IDs
MAIN_GROUP_ID=-1001234567890
THREAD_SALES=2
THREAD_ASSORTMENT=3
THREAD_ARRIVAL=4
THREAD_PREORDER=5

# Служебный топик для ответов бота (0 если не используется)
THREAD_SERVICE=0

# Database URL (postgresql+asyncpg://user:pass@host/dbname)
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/bot_db

# Optional: plan amount for statistics
PLAN_AMOUNT=600000

# Render external URL for webhook (set on Render)
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Port for the web server (default 8000)
PORT=8000

# Admin panel settings
# Либо plain пароль (менее безопасно):
ADMIN_PASSWORD=your_plain_password
# Либо bcrypt хэш (рекомендуется):
ADMIN_PASSWORD_HASH=$2b$12$...

# Secret key for session middleware (min 32 chars)
SECRET_KEY=your_secret_key_here_min_32_characters_long

# Redis URL for scaling and caching
REDIS_URL=redis://localhost:6379/0

# Database pool settings (optional)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# Logging options
LOG_FORMAT=text   # или json
LOG_TO_FILE=false
APP_VERSION=3.1.0

# Enable scaling mode (requires Redis)
SCALING_ENABLED=false
