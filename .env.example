cat > .env.example << 'EOF'
# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789,987654321
MAIN_GROUP_ID=-1001234567890

# Thread IDs
THREAD_SALES=1
THREAD_ASSORTMENT=2
THREAD_ARRIVAL=3
THREAD_PREORDER=4
THREAD_SERVICE=0

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/botdb

# Redis (для масштабирования)
REDIS_URL=redis://localhost:6379/0

# Webhook & Admin
RENDER_EXTERNAL_URL=https://your-app.onrender.com
SECRET_KEY=change_this_to_at_least_32_chars_random
ADMIN_PASSWORD_HASH=bcrypt_hash_here    # сгенерируйте через python scripts/generate_hash.py
PLAN_AMOUNT=600000

# Optional
SENTRY_DSN=
ENVIRONMENT=production
LOG_FORMAT=json
EOF
