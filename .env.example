# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администраторов через запятую (можно несколько)
ADMIN_ID=123456789,987654321

# ID основной группы (чат, где работает бот)
MAIN_GROUP_ID=-1001234567890

# ID топиков в группе
THREAD_SALES=123
THREAD_ASSORTMENT=124
THREAD_ARRIVAL=125
THREAD_PREORDER=126

# PostgreSQL (для Render.com)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Дневной план продаж (необязательно)
PLAN_AMOUNT=600000
