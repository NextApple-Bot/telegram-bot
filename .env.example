# Telegram Bot Token (обязательно)
BOT_TOKEN=your_bot_token_here

# Admin IDs (числовые, через запятую, без пробелов)
ADMIN_ID=12345678,87654321

# Group and thread IDs (обязательно)
MAIN_GROUP_ID=-1001234567890
THREAD_SALES=2
THREAD_ASSORTMENT=3
THREAD_ARRIVAL=4
THREAD_PREORDER=5

# Database URL (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/bot_db

# Optional: plan amount for statistics
PLAN_AMOUNT=600000

# Render external URL for webhook (set on Render)
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Port for the web server (default 8000)
PORT=8000

# Admin panel password (обязательно для доступа к веб-админке)
ADMIN_PASSWORD=your_secure_password

# Secret key for session middleware (обязательно, минимум 32 символа)
# Сгенерируйте командой: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_here_min_32_chars
